# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-4-6
PORT=8787
MCP_PORT=8788
MCP_SERVER_URL=http://localhost:8788/mcp

# Staff portal — dev-only, see docker-compose.yml and README's "Staff portal"
# section. Everything below is a local placeholder, never a real credential.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agentic-lending
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
STAFF_CLIENT_ID=staff-portal
STAFF_CLIENT_SECRET=dev-secret-change-me
STAFF_SESSION_SECRET=dev-session-secret-change-me
STAFF_PORT=8791
STAFF_CALLBACK_URL=http://localhost:8791/auth/callback
STAFF_CLIENT_ORIGIN=http://localhost:5174
